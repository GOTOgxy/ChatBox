{
  "manifest_version": 3,
  "name": "ChatBox Cookie Bridge",
  "version": "0.3.1",
  "description": "Send AI chat site cookies to the ChatBox desktop app",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "scripting", "tabs"],
  "host_permissions": [
    "*://*/*",
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://*.auth0.com/*",
    "https://*.google.com/*",
    "https://*.tongyi.com/*",
    "https://*.qianwen.com/*",
    "https://*.aliyun.com/*",
    "https://*.alibaba.com/*",
    "https://*.alicdn.com/*",
    "https://*.aliyuncs.com/*",
    "https://*.taobao.com/*",
    "https://*.mmstat.com/*",
    "https://*.kimi.com/*",
    "https://*.moonshot.cn/*",
    "https://*.deepseek.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" }
}
