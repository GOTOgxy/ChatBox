{
  "name": "chatbox",
  "productName": "ChatBox",
  "version": "1.5.7",
  "description": "Fast cross-platform hub for AI chat web apps",
  "main": "src/main/index.js",
  "author": "ChatBox",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "icons:app": "node scripts/make-app-icons.js",
    "pack:crx": "node scripts/pack-crx.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "checksums": "node scripts/make-checksums.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chatbox.app",
    "productName": "ChatBox",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "native-host/**/*",
      "extension/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/tray.png",
      "assets/tray@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChatBox",
      "artifactName": "ChatBox-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "artifactName": "ChatBox-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
